# Copy to .env (never commit .env) and fill in from your Adobe Developer Console project
# (OAuth Server-to-Server credential with the Experience Platform API added).
AEP_CLIENT_ID=<your_client_id>
AEP_CLIENT_SECRET=<your_client_secret>
AEP_ORG_ID=<your_org_id>@AdobeOrg
AEP_SANDBOX=<your_dev_sandbox_name>
# Scopes as shown on your credential in Developer Console
AEP_SCOPES=openid,session,AdobeID,read_organizations,additional_info.projectedProductContext
